{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["sin1"],
  "functions": {
    "src/app/api/resolve/route.js": { "maxDuration": 60 },
    "src/app/api/download/route.js": { "maxDuration": 60 },
    "src/app/api/monitor/route.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron/cleanup", "schedule": "0 0 * * *" }
  ]
}
